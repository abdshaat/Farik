#!/bin/sh
# The real Docker, except that the first `info` of a serve answers late, as a cold daemon's does
# on a CI runner: Catervas asks `docker info` once, when the first page needs to know, and a page that
# waits for that answer shows an empty team. Every other command passes straight through.
# That `info` only waits and succeeds, and never runs the real client: Catervas reads nothing but its
# exit code, and a slow real daemon on top of the delay would run past the ten seconds the probe
# gives it, which counts Docker as absent. CATERVAS_E2E_DOCKER is the real docker;
# CATERVAS_E2E_INFO_ASKED is a path no earlier `info` of this serve has made, and `mkdir` makes only
# the first take the delay.
if [ "$1" = info ] && mkdir "$CATERVAS_E2E_INFO_ASKED" 2>/dev/null; then
	sleep "${CATERVAS_E2E_INFO_DELAY:-8}"
	exit 0
fi
exec "$CATERVAS_E2E_DOCKER" "$@"
