{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"files": {
		"includes": [
			"*.json",
			"packages/**",
			"apps/**",
			"!**/generated",
			"!**/dist",
			"!**/node_modules"
		]
	},
	"formatter": { "enabled": true },
	"linter": { "enabled": true },
	"overrides": [
		{
			"includes": ["apps/web/src/assets/services/*.svg"],
			"linter": { "rules": { "a11y": { "noSvgWithoutTitle": "off" } } }
		}
	]
}
