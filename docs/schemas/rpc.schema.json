{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farik.dev/schemas/rpc.schema.json",
  "title": "Farik RPC",
  "description": "The JSON-RPC 2.0 text frames between the browser and the daemon's GET /rpc (docs/SPEC.md section 8). Any frame is a request, a response, or a notification; the query results and the command reply are $defs, which name the shape of each answer. command and event are objects here, not references, because one schema never references another: command_from_value and event_from_value read them.",
  "oneOf": [
    {
      "$ref": "#/$defs/rpcRequest"
    },
    {
      "$ref": "#/$defs/rpcResponse"
    },
    {
      "$ref": "#/$defs/rpcNotification"
    }
  ],
  "$defs": {
    "requestId": {
      "type": "integer",
      "description": "The caller's own number for a request, echoed by its response."
    },
    "queryName": {
      "type": "string",
      "enum": [
        "events.since",
        "tasks.list",
        "task.get",
        "team.get",
        "serve.status",
        "folders.list",
        "computer.check",
        "account.status"
      ]
    },
    "subscribeRequest": {
      "title": "Subscribe Request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "subscribe"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from_seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          },
          "required": [
            "from_seq"
          ]
        }
      }
    },
    "unsubscribeRequest": {
      "title": "Unsubscribe Request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "unsubscribe"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "commandRequest": {
      "title": "Command Request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "command"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "object",
              "description": "A command wire of command.schema.json; the daemon validates it with command_from_value."
            }
          },
          "required": [
            "command"
          ]
        }
      }
    },
    "queryRequest": {
      "title": "Query Request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "query"
        },
        "params": {
          "oneOf": [
            {
              "$ref": "#/$defs/eventsSinceQuery"
            },
            {
              "$ref": "#/$defs/tasksListQuery"
            },
            {
              "$ref": "#/$defs/taskGetQuery"
            },
            {
              "$ref": "#/$defs/teamGetQuery"
            },
            {
              "$ref": "#/$defs/serveStatusQuery"
            },
            {
              "$ref": "#/$defs/foldersListQuery"
            },
            {
              "$ref": "#/$defs/computerCheckQuery"
            },
            {
              "$ref": "#/$defs/accountStatusQuery"
            }
          ]
        }
      }
    },
    "eventsSinceQuery": {
      "title": "Events Since Query",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "events.since"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "after_seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          "required": [
            "after_seq",
            "limit"
          ]
        }
      }
    },
    "tasksListQuery": {
      "title": "Tasks List Query",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "tasks.list"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "taskGetQuery": {
      "title": "Task Get Query",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "task.get"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_id": {
              "type": "string",
              "pattern": "^FRK-[0-9]{1,6}$"
            }
          },
          "required": [
            "task_id"
          ]
        }
      }
    },
    "teamGetQuery": {
      "title": "Team Get Query",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "team.get"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "serveStatusQuery": {
      "title": "Serve Status Query",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "serve.status"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "rpcRequest": {
      "title": "Rpc Request",
      "description": "What the browser sends. The pairing of a query's name with its params is the schema's; the meaning of a command is command_from_value's.",
      "oneOf": [
        {
          "$ref": "#/$defs/subscribeRequest"
        },
        {
          "$ref": "#/$defs/unsubscribeRequest"
        },
        {
          "$ref": "#/$defs/commandRequest"
        },
        {
          "$ref": "#/$defs/queryRequest"
        },
        {
          "$ref": "#/$defs/projectOpenRequest"
        },
        {
          "$ref": "#/$defs/projectCreateRequest"
        },
        {
          "$ref": "#/$defs/accountConnectRequest"
        },
        {
          "$ref": "#/$defs/sandboxBuildRequest"
        }
      ]
    },
    "rpcSuccess": {
      "title": "Rpc Success",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "result": {
          "type": "object",
          "description": "emptyResult for subscribe and unsubscribe, commandReply for command, the query's own result def for query, and the method's own result def (projectOpenResult, projectCreateResult, accountConnectResult, sandboxBuildResult) for a setup method."
        }
      }
    },
    "rpcFailure": {
      "title": "Rpc Failure",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "$ref": "#/$defs/requestId"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when the request's id could not be read."
        },
        "error": {
          "$ref": "#/$defs/rpcError"
        }
      }
    },
    "rpcError": {
      "title": "Rpc Error",
      "description": "-32700 parse, -32600 invalid request, -32601 unknown method, -32602 invalid params, -32603 internal (the store or a file failed), -32001 unknown_query, -32002 not_found, -32003 refused_here, -32004 no_project (the daemon has no project yet, so it answers only the setup queries), -32005 refused (a setup method was refused; the message is the sentence to show).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "enum": [
            -32700,
            -32600,
            -32601,
            -32602,
            -32603,
            -32001,
            -32002,
            -32003,
            -32004,
            -32005
          ]
        },
        "message": {
          "type": "string"
        },
        "data": {}
      }
    },
    "rpcResponse": {
      "title": "Rpc Response",
      "oneOf": [
        {
          "$ref": "#/$defs/rpcSuccess"
        },
        {
          "$ref": "#/$defs/rpcFailure"
        }
      ]
    },
    "rpcNotification": {
      "title": "Rpc Notification",
      "description": "The server's push of one event. The event is an object here because one schema never references another; rpc_notification_from_value reads it with event_from_value.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "event"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "event": {
              "type": "object"
            }
          },
          "required": [
            "event"
          ]
        }
      }
    },
    "emptyResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "commandReply": {
      "title": "Command Reply",
      "description": "What the daemon's POST /command answers once the token passes (docs/SPEC.md section 8.2): what the command did, as one sentence and the sequence numbers of the events it appended, or why it did nothing. A reply is what leaves a process, so it has a schema as a command does; farik_protocol::command::reply_from_value reads it against this definition.",
      "oneOf": [
        {
          "$ref": "#/$defs/commandDone"
        },
        {
          "$ref": "#/$defs/commandRefusal"
        }
      ]
    },
    "commandDone": {
      "title": "Command Done",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "said",
        "events"
      ],
      "properties": {
        "said": {
          "type": "string"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18446744073709551615
          }
        }
      }
    },
    "commandRefusal": {
      "title": "Command Refusal",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "detail"
          ],
          "properties": {
            "kind": {
              "description": "invalid: the command cannot be handled as given, a schema refusal among them; refused: it cannot be done to what it names as things stand; not_found: what it names is not there; failed: the store, a file, git, or the orchestrator failed.",
              "type": "string",
              "enum": [
                "invalid",
                "refused",
                "not_found",
                "failed"
              ]
            },
            "detail": {
              "type": "string"
            }
          }
        }
      }
    },
    "eventsSinceResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "events"
      ]
    },
    "tasksListResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskProjection"
          }
        }
      },
      "required": [
        "tasks"
      ]
    },
    "taskGetResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task": {
          "$ref": "#/$defs/taskProjection"
        }
      },
      "required": [
        "task"
      ]
    },
    "teamGetResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "team": {
          "type": "object",
          "description": "The team file as team.schema.json shapes it."
        }
      },
      "required": [
        "team"
      ]
    },
    "serveStatusResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_root": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null while the daemon is in setup mode, before a project is chosen."
        },
        "paused": {
          "type": "boolean"
        },
        "credential": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "api_key",
                "subscription_token"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "take_on_error": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why taking the chosen project on failed, or null."
        }
      },
      "required": [
        "project_root",
        "paused",
        "credential",
        "take_on_error",
        "port"
      ]
    },
    "taskProjection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^FRK-[0-9]{1,6}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "epic",
            "task"
          ]
        },
        "parent": {
          "type": "string",
          "pattern": "^FRK-[0-9]{1,6}$"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "refining",
            "ready",
            "assigned",
            "in_progress",
            "blocked",
            "verifying",
            "rejected",
            "accepted",
            "escalated",
            "cancelled"
          ]
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "triaged": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "updated_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "cost_usd": {
          "type": "number"
        },
        "assignee_id": {
          "type": "string"
        },
        "reviewer_id": {
          "type": "string"
        },
        "iteration": {
          "type": "integer",
          "minimum": 0
        },
        "awaiting_integration": {
          "type": "boolean"
        },
        "waiting_on_human": {
          "type": "boolean"
        },
        "awaiting_approval": {
          "type": "boolean"
        },
        "verifications": {
          "type": "integer",
          "minimum": 0
        },
        "rejections": {
          "type": "integer",
          "minimum": 0
        },
        "interventions": {
          "type": "integer",
          "minimum": 0
        },
        "sprint": {
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "kind",
        "title",
        "status",
        "risk",
        "triaged",
        "locked",
        "updated_seq",
        "cost_usd",
        "iteration",
        "awaiting_integration",
        "waiting_on_human",
        "awaiting_approval",
        "verifications",
        "rejections",
        "interventions"
      ],
      "description": "One row of the board (farik_store::TaskProjection). Optional fields are absent, not null, when the projection has none."
    },
    "foldersListQuery": {
      "title": "Folders List Query",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "folders.list"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            }
          }
        }
      }
    },
    "computerCheckQuery": {
      "title": "Computer Check Query",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "computer.check"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "accountStatusQuery": {
      "title": "Account Status Query",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "account.status"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "projectOpenRequest": {
      "title": "Project Open Request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "project.open"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "no_sandbox": {
              "type": "boolean"
            }
          },
          "required": [
            "path",
            "no_sandbox"
          ]
        }
      }
    },
    "projectCreateRequest": {
      "title": "Project Create Request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "project.create"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parent": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "no_sandbox": {
              "type": "boolean"
            }
          },
          "required": [
            "parent",
            "name",
            "description",
            "no_sandbox"
          ]
        }
      }
    },
    "accountConnectRequest": {
      "title": "Account Connect Request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "account.connect"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "api_key",
                "subscription_token"
              ]
            },
            "secret": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "secret"
          ]
        }
      }
    },
    "sandboxBuildRequest": {
      "title": "Sandbox Build Request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "sandbox.build"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "foldersListResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "parent": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "git": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "git"
            ]
          }
        }
      },
      "required": [
        "path",
        "parent",
        "entries"
      ]
    },
    "computerItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "ready",
            "missing",
            "too_old",
            "not_running"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "state"
      ]
    },
    "computerCheckResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude": {
          "$ref": "#/$defs/computerItem"
        },
        "git": {
          "$ref": "#/$defs/computerItem"
        },
        "docker": {
          "$ref": "#/$defs/computerItem"
        },
        "sandbox_image": {
          "$ref": "#/$defs/computerItem"
        }
      },
      "required": [
        "claude",
        "git",
        "docker",
        "sandbox_image"
      ]
    },
    "accountStatusResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "oneOf": [
            {
              "const": "anthropic"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "oneOf": [
            {
              "type": "string",
