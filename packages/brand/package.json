{
	"name": "@catervas/brand",
	"private": true,
	"type": "module",
	"scripts": {
		"generate": "node src/generate.ts",
		"icons": "node src/icons.ts",
		"typecheck": "tsc --noEmit -p .",
		"sheet": "vite build --config sheet/vite.config.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"@fontsource/jetbrains-mono": "5.3.0",
		"@fontsource/silkscreen": "5.3.0",
		"@fontsource/space-grotesk": "5.3.0"
	},
	"devDependencies": {
		"axe-core": "4.13.0",
		"jsdom": "30.1.1",
		"sharp": "0.35.5",
		"vite": "8.3.1"
	},
	"exports": {
		".": "./src/index.ts",
		"./tokens.css": "./dist/tokens.css",
		"./fonts.css": "./src/fonts.css",
		"./assets/*": "./assets/*"
	}
}
